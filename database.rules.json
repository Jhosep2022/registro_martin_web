{
  "rules": {
    ".read": false,
    ".write": false,
    "registro": {
      ".read": "auth != null",
      ".write": "auth != null && newData.exists()",
      ".validate": "newData.hasChild('nextId')",
      "nextId": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0 && (!data.exists() || newData.val() >= data.val())"
      },
      "notas": {
        "$id": {
          ".validate": "newData.hasChildren(['id', 'numeroHojaRuta', 'fecha', 'remitente', 'referencia', 'destino'])",
          "id": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0 && $id === '' + newData.val() && (!data.exists() || newData.val() === data.val())"
          },
          "numeroHojaRuta": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{3,}$/) && (!data.exists() || newData.val() === data.val())"
          },
          "fecha": {
            ".validate": "newData.isString() && newData.val().matches(/^(20[2-9][0-9]|2100)-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
          },
          "remitente": {
            ".validate": "newData.isString() && newData.val().length <= 10000 && newData.val().matches(/[^ \\t\\r\\n]/)"
          },
          "referencia": {
            ".validate": "newData.isString() && newData.val().length <= 10000 && newData.val().matches(/[^ \\t\\r\\n]/)"
          },
          "destino": {
            ".validate": "newData.isString() && newData.val().length <= 10000 && newData.val().matches(/[^ \\t\\r\\n]/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
