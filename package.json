{
  "name": "registro-martin-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/unit.test.ts",
    "test:integration": "node --import tsx --test test/firebase.test.ts",
    "test:e2e": "playwright test",
    "test:firebase": "firebase emulators:exec --project demo-registro-martin --only auth,database \"npm run test:integration && npm run test:e2e\"",
    "emulators": "firebase emulators:start --project demo-registro-martin --only auth,database",
    "deploy": "node --import tsx scripts/deploy.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.30.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
